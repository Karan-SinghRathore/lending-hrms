// SQLite for the demo. To move to Postgres later: provider = "postgresql"
// and point DATABASE_URL at the Postgres database.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Branch {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  name      String
  city      String
  state     String
  lat       Float
  lng       Float
  employees Employee[]
  jobs      JobOpening[]
}

model Employee {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  name        String
  email       String    @unique
  phone       String
  gender      String
  designation String
  department  String
  // HR | MANAGER | EMPLOYEE — drives what the person can see and do
  accessRole  String    @default("EMPLOYEE")
  // The named role decides which modules the person can open; accessRole mirrors role.base.
  roleId      Int?
  role        Role?     @relation(fields: [roleId], references: [id])
  // SALES | COLLECTION | NONE — which incentive plan applies
  plan        String    @default("NONE")
  joinDate    DateTime
  status      String    @default("ACTIVE")
  monthlyCtc  Int
  branchId    Int
  branch      Branch    @relation(fields: [branchId], references: [id])
  managerId   Int?
  manager     Employee? @relation("Reports", fields: [managerId], references: [id])
  reports     Employee[] @relation("Reports")

  leaveRequests   LeaveRequest[] @relation("LeaveApplicant")
  leavesDecided   LeaveRequest[] @relation("LeaveApprover")
  leaveAllocations LeaveAllocation[]
  attendance      Attendance[]
  targets         Target[]
  payslips        Payslip[]
  checklists      ChecklistCase[]
  appraisals      Appraisal[]
  letters         Letter[]
  documents       EmployeeDocument[]
  trainings       TrainingAssignment[]
}

model LeaveAllocation {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])
  year       Int
  // CL | SL | EL
  type       String
  allocated  Float

  @@unique([employeeId, year, type])
}

model LeaveRequest {
  id         Int       @id @default(autoincrement())
  employeeId Int
  employee   Employee  @relation("LeaveApplicant", fields: [employeeId], references: [id])
  type       String
  fromDate   String    // YYYY-MM-DD
  toDate     String    // YYYY-MM-DD
  halfDay    Boolean   @default(false)
  days       Float
  reason     String
  // PENDING | APPROVED | REJECTED | CANCELLED
  status     String    @default("PENDING")
  approverId Int?
  approver   Employee? @relation("LeaveApprover", fields: [approverId], references: [id])
  remark     String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())
}

model Holiday {
  id   Int    @id @default(autoincrement())
  date String @unique // YYYY-MM-DD
  name String
}

model Attendance {
  id         Int       @id @default(autoincrement())
  employeeId Int
  employee   Employee  @relation(fields: [employeeId], references: [id])
  date       String    // YYYY-MM-DD
  checkIn    DateTime?
  checkOut   DateTime?
  lat        Float?
  lng        Float?
  location   String?
  // PRESENT | LATE | HALF_DAY
  status     String

  @@unique([employeeId, date])
}

model Target {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])
  month      String   // YYYY-MM
  // SALES plan: DISBURSAL (₹), FILES (count)  ·  COLLECTION plan: COLLECTION (₹), RESOLVED (cases)
  metric     String
  target     Float
  achieved   Float    @default(0)
  // share of the incentive score, 0–100
  weight     Float
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, month, metric])
}

model IncentiveSlab {
  id     Int    @id @default(autoincrement())
  plan   String // SALES | COLLECTION
  minPct Float  // score from (inclusive)
  maxPct Float? // score up to (exclusive); null = no upper limit
  amount Int    // ₹ payout
}

model Payslip {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employee    Employee @relation(fields: [employeeId], references: [id])
  month       String   // YYYY-MM
  workingDays Int
  paidDays    Float
  lopDays     Float    // loss of pay: absent without approved leave
  basic       Int
  hra         Int
  allowance   Int
  incentive   Int
  lopAmount   Int
  gross       Int      // earnings after loss of pay, including incentive
  pf          Int
  esi         Int
  pt          Int
  tds         Int
  net         Int
  // DRAFT | PAID
  status      String   @default("DRAFT")
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  @@unique([employeeId, month])
}

model ChecklistCase {
  id         Int             @id @default(autoincrement())
  employeeId Int
  employee   Employee        @relation(fields: [employeeId], references: [id])
  // JOINING | EXIT
  kind       String
  startedAt  DateTime        @default(now())
  tasks      ChecklistTask[]
}

model ChecklistTask {
  id     Int           @id @default(autoincrement())
  caseId Int
  case   ChecklistCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title  String
  // HR | MANAGER | EMPLOYEE — who is expected to complete it
  owner  String
  done   Boolean       @default(false)
  doneBy String?
  doneAt DateTime?
  sort   Int           @default(0)
}

model AppraisalCycle {
  id         Int         @id @default(autoincrement())
  name       String
  fromMonth  String
  toMonth    String
  // OPEN | CLOSED
  status     String      @default("OPEN")
  createdAt  DateTime    @default(now())
  appraisals Appraisal[]
}

model Appraisal {
  id             Int            @id @default(autoincrement())
  cycleId        Int
  cycle          AppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId     Int
  employee       Employee       @relation(fields: [employeeId], references: [id])
  targetScore    Float?         // average monthly target score in the period, if on a plan
  selfRating     Int?
  selfComment    String?
  managerRating  Int?
  managerComment String?
  finalRating    Int?
  incrementPct   Float?
  hrComment      String?
  // SELF → MANAGER → HR → DONE
  status         String         @default("SELF")

  @@unique([cycleId, employeeId])
}

model Role {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  // Data scope and write level: HR = whole company, MANAGER = own branch, EMPLOYEE = self
  base      String
  modules   String     // JSON array of module keys this role can open
  locked    Boolean    @default(false) // the admin role cannot be edited
  employees Employee[]
}

model JobOpening {
  id         Int         @id @default(autoincrement())
  title      String
  branchId   Int
  branch     Branch      @relation(fields: [branchId], references: [id])
  openings   Int
  // OPEN | CLOSED
  status     String      @default("OPEN")
  createdAt  DateTime    @default(now())
  candidates Candidate[]
}

model Candidate {
  id          Int        @id @default(autoincrement())
  jobId       Int
  job         JobOpening @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  source      String
  // APPLIED → SCREENING → INTERVIEW → OFFERED → HIRED, or REJECTED
  stage       String     @default("APPLIED")
  expectedCtc Int?
  notes       String?
  employeeId  Int?       // set once the hired candidate is added as an employee
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Letter {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])
  type       String
  body       String
  issuedBy   String
  issuedAt   DateTime @default(now())
}

model EmployeeDocument {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])
  kind       String
  fileName   String
  mime       String
  size       Int
  data       Bytes    // prototype only; a real deployment keeps files in file storage
  uploadedBy String
  uploadedAt DateTime @default(now())
  verified   Boolean  @default(false)
  verifiedBy String?
}

model TrainingProgram {
  id          Int                  @id @default(autoincrement())
  title       String
  category    String
  mandatory   Boolean              @default(true)
  dueDate     String?              // YYYY-MM-DD
  description String?
  createdAt   DateTime             @default(now())
  assignments TrainingAssignment[]
}

model TrainingAssignment {
  id          Int             @id @default(autoincrement())
  programId   Int
  program     TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  employeeId  Int
  employee    Employee        @relation(fields: [employeeId], references: [id])
  // ASSIGNED | COMPLETED
  status      String          @default("ASSIGNED")
  completedAt DateTime?
  markedBy    String?

  @@unique([programId, employeeId])
}
